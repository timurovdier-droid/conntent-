# Локальная SQLite через libSQL. Для Turso Cloud замените URL и добавьте токен.
TURSO_DATABASE_URL=file:data/contentpilot.db
TURSO_AUTH_TOKEN=

# Секреты только на сервере. Не добавляйте префикс NEXT_PUBLIC_.
AUTH_SECRET=replace-with-a-long-random-string
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Необязательно. Без токена файлы пишутся в ./storage локально и не сохраняются на Vercel.
BLOB_READ_WRITE_TOKEN=

# Необязательно. Без ключа ссылка сброса пароля видна только в development.
RESEND_API_KEY=
EMAIL_FROM=

# Эти адреса получают is_admin при регистрации.
ADMIN_EMAILS=

# Временные квоты до измерения реальной стоимости. Меняются в админке.
TEXT_DAILY_QUOTA=40
IMAGE_DAILY_QUOTA=8
UPLOAD_DAILY_QUOTA=20
EMBED_DAILY_QUOTA=200
RATE_PER_MINUTE=10
MAX_UPLOAD_BYTES=10485760
